  "scannerTitle": "Scanner le colis",
  "@scannerTitle": {
    "description": "Title of the barcode scanner screen. Names the object the driver is holding, not the technology."
  },
  "scannerAim": "Cadrez le code-barres",
  "@scannerAim": {
    "description": "Instruction over the camera preview. Short because it is read at arm's length while holding a parcel."
  },
  "scannerTorch": "Lumière",
  "@scannerTorch": {
    "description": "Toggles the camera flash. Named for what it does for the driver — a stairwell at 07:00 is dark — rather than 'flash' or 'torch mode'."
  },
  "scannerManualEntry": "Saisir à la main",
  "@scannerManualEntry": {
    "description": "Skips the scan and opens the order form directly. Always available, not only after a failure: a damaged or missing label is ordinary, and a scanner that traps the driver is worse than no scanner."
  },
  "scannerPermissionTitle": "Appareil photo non autorisé",
  "@scannerPermissionTitle": {
    "description": "Shown when camera permission was refused. States the fact without blaming — refusing a permission is a reasonable thing to have done."
  },
  "scannerPermissionBody": "L'appareil photo est nécessaire pour scanner. Vous pouvez saisir le numéro à la main, ou autoriser l'accès dans les réglages du téléphone.",
  "@scannerPermissionBody": {
    "description": "Offers manual entry FIRST and settings second. A driver who declined at 07:00 in an agency needs to enter the order now, not navigate Android settings; the entry form works without a scan. Same reasoning as an unparseable phone not blocking order creation."
  },
  "scannerUnavailableTitle": "Appareil photo indisponible",
  "@scannerUnavailableTitle": {
    "description": "Shown when the camera cannot start for any reason other than permission — hardware in use by another app, or a device fault."
  },
  "scannerUnavailableBody": "Le scanner n'a pas pu démarrer. Saisissez le numéro à la main pour continuer.",
  "@scannerUnavailableBody": {
    "description": "Deliberately does not guess the cause. The driver's next step is the same whatever it was."
  },
  "orderNewTitle": "Nouveau colis",
  "@orderNewTitle": {
    "description": "Title of the order entry screen. `colis`, not `commande`: a commande is what the customer placed on a website, a colis is the object in the driver's hand with the tracking number printed on it, and it is the unit counted at the agency in the morning. The entity stays `Order` in code; the screen uses the driver's word."
  },
  "orderFieldTracking": "N° de suivi",
  "@orderFieldTracking": {
    "description": "The tracking number, pre-filled from a scan. The only field this form requires."
  },
  "orderFieldPhone": "Téléphone",
  "@orderFieldPhone": {
    "description": "The customer's number, and the first field focused. Typing it looks the customer up as it goes, which is what saves retyping a name and an address."
  },
  "orderFieldName": "Nom",
  "@orderFieldName": {
    "description": "The customer's name. Shown only when the number belongs to nobody yet — an existing customer is a card, not a set of fields to retype."
  },
  "orderFieldCommune": "Commune",
  "@orderFieldCommune": {
    "description": "The commune of the delivery address. Opens a searchable list; a driver reading a French label and a driver typing Arabic must find the same commune."
  },
  "orderFieldAddress": "Adresse",
  "@orderFieldAddress": {
    "description": "Free text under the commune: the cité, the block, the floor — what a driver actually uses to find a door. Without it a new customer's order has only a commune centroid, which is confidence tier 1 and clusters as a zone stop rather than routing to an address."
  },
  "orderFieldCod": "À encaisser",
  "@orderFieldCod": {
    "description": "The cash to collect at the door, in dinars. The driver's phrase for the money in their hand rather than the manifest's 'montant COD'."
  },
  "orderFieldNotes": "Remarque",
  "@orderFieldNotes": {
    "description": "Anything the driver wants to remember about this parcel. Optional and last."
  },
  "orderFieldDelivery": "Livraison",
  "@orderFieldDelivery": {
    "description": "Label above the home / stop-desk toggle."
  },
  "orderDeliveryHome": "À domicile",
  "@orderDeliveryHome": {
    "description": "Delivered to the customer's address. The default, and the majority of parcels."
  },
  "orderDeliveryStopdesk": "Point relais",
  "@orderDeliveryStopdesk": {
    "description": "Collected by the customer from an agency desk. Roughly half of Algerian COD volume, it cannot be derived from anything else — it comes off the label — and it must never enter the optimized route. One tap, on a minority of parcels."
  },
  "orderSave": "Enregistrer",
  "@orderSave": {
    "description": "Saves the parcel and closes the form."
  },
  "orderSaveAndNext": "Enregistrer et scanner",
  "@orderSaveAndNext": {
    "description": "Saves and reopens the scanner for the next parcel. The largest thing on the screen, because it is the loop the four-minute gate measures."
  },
  "orderSaved": "Colis enregistré.",
  "@orderSaved": {
    "description": "Confirmation after a save. `colis` for the same reason as the title."
  },
  "orderTrackingRequired": "Le n° de suivi est obligatoire.",
  "@orderTrackingRequired": {
    "description": "The only blocking validation on this form. Everything else is optional on purpose: a driver standing in an agency at 07:00 must not be stopped by a field, and a parcel with no customer yet is enterable even though it is not deliverable."
  },
  "orderDuplicateTracking": "Ce colis est déjà dans la tournée.",
  "@orderDuplicateTracking": {
    "description": "Shown when the tracking number is already in this company's orders. Stated as a fact, not an error — scanning the same parcel twice is the ordinary way this happens on a screen the driver hits fifteen times a morning, and no wording blames them for it."
  },
  "orderDuplicateOpen": "Voir le colis",
  "@orderDuplicateOpen": {
    "description": "One tap to the parcel that already carries the number, instead of making the driver go and look for it."
  },
  "orderCompanyLabel": "Société",
  "@orderCompanyLabel": {
    "description": "Names the company today's parcels came from. Chosen once per batch and never per order, so it is a header on this form rather than a field in it."
  },
  "orderCompanyChange": "Changer",
  "@orderCompanyChange": {
    "description": "Switches the company, which switches the batch. A driver working two companies in one day has two batches and one route."
  },
  "orderNoCompanyTitle": "Aucune société",
  "@orderNoCompanyTitle": {
    "description": "Empty state on the first launch, before any company exists. Nothing is seeded — an invented company would end up in a settlement."
  },
  "orderNoCompanyBody": "Ajoutez la société qui vous a remis ces colis.",
  "@orderNoCompanyBody": {
