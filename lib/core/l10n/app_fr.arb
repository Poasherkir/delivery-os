  "customerLookupExisting": "Vous avez déjà ce client",
  "@customerLookupExisting": {
    "description": "Heading on the card shown when the number typed already belongs to someone. Phrased as a fact the driver owns rather than as a warning — finding an existing customer is the good outcome, because it saves retyping a name and an address."
  },
  "customerLookupOrders": "{count, plural, =0{Aucune commande} =1{1 commande} other{{count} commandes}}",
  "@customerLookupOrders": {
    "description": "Order count on the existing-customer card. It is the fastest way for a driver to recognise whether this is the person they mean.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "customerLookupUse": "Utiliser ce client",
