    "description": "Points at the scan FAB, which is the only way into the list."
  },
  "orderListNeedsCustomer": "Client à ajouter",
  "@orderListNeedsCustomer": {
    "description": "Badge on a list row for a parcel entered with no phone number, in the same neutral register as customerNeedsPhoneReview — this is an ordinary state a manifest produces, not a mistake."
  },
  "orderListNeedsAddress": "Adresse à ajouter",
  "@orderListNeedsAddress": {
    "description": "Badge on a list row for a parcel with a customer but no commune. A driver doing end-of-morning cleanup uses this to find what still needs an address before a route can be built."
