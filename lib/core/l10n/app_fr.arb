    "description": "Validation message."
  },
  "customerPhoneRequired": "Le numéro est obligatoire.",
  "@customerPhoneRequired": {
    "description": "Validation message. A customer with no number at all cannot be found again."
  },
  "customerPhoneUnrecognized": "Numéro non reconnu. Il sera enregistré tel quel, à corriger plus tard.",
  "@customerPhoneUnrecognized": {
    "description": "Shown when the number does not parse. Deliberately NOT an error: it does not block saving. A driver in an agency at 07:00 must not be stopped because our validator disagrees with a real landline. States what will happen rather than refusing."
  },
  "customerDuplicate": "Ce numéro appartient déjà à {name}.",
  "@customerDuplicate": {
