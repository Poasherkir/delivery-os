    "description": "Search field at the top of the commune picker. Matches either name, so the French label on a parcel and an Arabic spelling find the same commune."
  },
  "orderCommuneNoResults": "Aucune commune ne correspond.",
  "@orderCommuneNoResults": {
    "description": "Shown when a commune search matches nothing."
  },
  "companyNewTitle": "Nouvelle société",
  "@companyNewTitle": {
    "description": "Title of the company form."
  },
  "companyFieldName": "Nom",
  "@companyFieldName": {
    "description": "The company's name, and the only thing a driver has to type."
  },
  "companyFieldPhone": "Téléphone",
  "@companyFieldPhone": {
    "description": "Free text, not a validated number: agencies hand out a mobile and a landline together, which is useful to a driver and is not a phone number."
  },
  "companyFieldNotes": "Remarque",
  "@companyFieldNotes": {
    "description": "Anything worth remembering about this company."
  },
  "companySave": "Enregistrer",
  "@companySave": {
    "description": "Saves the company and returns to whatever needed it."
  },
  "companyNameRequired": "Le nom est obligatoire.",
  "@companyNameRequired": {
    "description": "The only validation on the company form."
  },
  "companiesEmptyTitle": "Aucune société",
  "@companiesEmptyTitle": {
    "description": "Empty state on the companies screen."
  },
  "companiesEmptyBody": "Ajoutez les sociétés dont vous livrez les colis.",
  "@companiesEmptyBody": {
    "description": "Explains what belongs on this screen in the driver's terms."
  },
  "companiesNew": "Nouvelle société",
  "@companiesNew": {
    "description": "Opens the company form from the companies screen."
  },
  "moneyCurrency": "DA",
